{
  "name": "ba.ovo.putplay",
  "version": "1.1.1",
  "private": true,
  "description": "put.io browser & player for webOS TV",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite --open=dev.html",
    "package": "pnpm build && node build/package.mjs",
    "deploy:tv": "node build/deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hls.js": "1.0.11",
    "pako": "^3.0.2",
    "webostvjs": "^1.2.13"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.6",
    "svelte": "^4.2.20",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
