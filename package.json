{
  "name": "io.put.lg",
  "version": "1.0.0",
  "private": true,
  "description": "put.io browser & player for webOS TV",
  "scripts": {
    "build": "node build/esbuild.mjs",
    "watch": "node build/esbuild.mjs --watch",
    "package": "npm run build && node build/package.mjs",
    "deploy:tv": "node build/deploy.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "hls.js": "1.0.11",
    "webostvjs": "^1.2.13"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "svelte": "^4.2.20",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
