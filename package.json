{
  "name": "ba.ovo.putplay",
  "version": "1.1.1",
  "private": true,
  "description": "put.io browser & player for webOS TV",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "node build/esbuild.mjs",
    "watch": "node build/esbuild.mjs --watch",
    "package": "pnpm build && node build/package.mjs",
    "deploy:tv": "node build/deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hls.js": "1.0.11",
    "pako": "^3.0.2",
    "webostvjs": "^1.2.13"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^4.2.20",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
